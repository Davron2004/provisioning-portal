{
  "name": "@provisioning/api",
  "version": "0.1.0",
  "private": true,
  "description": "Lambda handlers (REST, WebSocket, order workflow, stream consumers) and the local dev harness.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/local/server.ts",
    "start:local": "tsx src/local/server.ts",
    "seed": "tsx src/local/seed-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint --no-warn-ignored src"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.1.3",
    "@anthropic-ai/sdk": "^1.12.0",
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1175.0",
    "@aws-sdk/client-dynamodb": "^3.1175.0",
    "@aws-sdk/client-dynamodb-streams": "^3.1175.0",
    "@aws-sdk/client-sfn": "^3.1175.0",
    "@aws-sdk/credential-provider-node": "^3.972.98",
    "@aws-sdk/lib-dynamodb": "^3.1175.0",
    "@opensearch-project/opensearch": "^3.10.0",
    "@provisioning/contracts": "*",
    "aws-jwt-verify": "^5.2.1",
    "jose": "^6.2.18",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.2",
    "aws-sdk-client-mock": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.1.1",
    "ws": "^8.23.0"
  }
}
